[worldserver]

###################################################################################################
#	Learn spells on level-up (Aldrynth fork)
###################################################################################################

# Enable the module? (1: true | 0: false)

LearnSpells.Enable = 1

# Announce the module when the player logs in?

LearnSpells.Announce = 0

# Should the player receive all spells on first login?
# Useful for instant leveling type of servers
# (1: true | 0: false)

LearnSpells.OnFirstLogin = 0

# Max level Limit the player will learn spells
# Aldrynth: 55 — levels 56–80 train from class trainers as normal

LearnSpells.MaxLevel = 55

# Keep the class quests: spells a quest teaches (Bear Form, Voidwalker, Defensive Stance,
# totems, Tame Beast, Redemption, ...) are NOT auto-learned on level-up. You get them by
# doing the class quest, and any higher ranks you already reached come right after.
# Shamans get their totem items from the quests too, not for free on first login.
# (1: learn quest spells from the quests | 0: auto-learn them on level-up, upstream behaviour)

LearnSpells.KeepClassQuests = 1
